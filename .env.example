# Copy to .env (git-ignored) and fill in. Never commit real values.
# Required
SECRET_KEY=change-me-to-a-long-random-string
LECTURER_PIN=change-me
BASE_URL=http://localhost:5000
# Optional
DATABASE_PATH=instance/app.db
YUNET_MODEL_PATH=models/face_detection_yunet_2023mar.onnx
FACE_SCORE_THRESHOLD=0.4
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
WHISPER_MODEL=small
# Empty = detect the language of each recording; or a code such as he / en
WHISPER_LANGUAGE=
# Upload limit of the video summary page only, in bytes (2 GiB)
VIDEO_MAX_BYTES=2147483648
# Temporary recordings live here while a job runs; keep it outside the repository. Empty = system temp folder
VIDEO_WORK_DIR=
PORT=5000
